# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
.env

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify
.netlify

# cloudflare / opennext
.open-next
.wrangler
cloudflare-env.d.ts
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# raw phone photo/video drops at the repo root (e.g. IMG_1234.jpeg) — these
# have twice been accidentally swept into unrelated commits by a broad
# `git add -A`. Real campaign assets live under public/, not the repo root.
/IMG_*.jpeg
/IMG_*.jpg
/IMG_*.heic
/IMG_*.mov
/IMG_*.mp4
/Ruck For the 22/
