# Copy this file to .env.local and fill in real values.
# Without Supabase configured, the site renders from bundled placeholder
# data (see src/lib/data/seed-data.ts) so local development still works.

# Supabase project URL and anon/publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server-only — NEVER prefix with NEXT_PUBLIC_ and
# never import it from a Client Component. Used only by trusted server code
# (the /api/inquiries route, the admin dashboard's aggregate reads).
SUPABASE_SERVICE_ROLE_KEY=

# Org root (www.forthe22.org in production) — movement/mission pages.
# Used for metadata, canonical URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Campaign root (tri.forthe22.org in production) — fundraising pages. See
# README's "Movement/Campaign Domain Split". Defaults to the same local
# origin as NEXT_PUBLIC_SITE_URL — there's no real second host in dev; use
# a `Host:` header override (or the OpenNext Cloudflare preview) to test
# the actual domain-split routing locally.
NEXT_PUBLIC_CAMPAIGN_URL=http://localhost:3000

# WHOOP OAuth app credentials (from https://developer.whoop.com), used to
# power the public "Latest Training" snapshot on /the-race and campaign
# home. Register {NEXT_PUBLIC_CAMPAIGN_URL}/api/whoop/callback as the
# app's redirect URL — /admin/whoop lives on the campaign domain. This is
# the athlete connecting their own account via /admin/whoop — without
# these set, the training snapshot section is hidden. Server-only.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Pre-launch gate (see src/lib/launch-gate.ts and README's "Pre-Launch Gate"
# section) — gated per domain. SITE_LIVE controls www.forthe22.org (org),
# CAMPAIGN_LIVE controls tri.forthe22.org (the fundraising campaign),
# independently. While the relevant flag isn't exactly "true", that
# domain shows a "Coming Soon" page instead of real content — donate/
# sponsor/merch links and form submissions included. Both "true" locally
# for normal dev.
SITE_LIVE=true
CAMPAIGN_LIVE=true
# Secret for the ?preview=<token> bypass link. Generate a random value, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.
# Set the SAME value on your deployment; rotate it to invalidate old links.
PREVIEW_ACCESS_TOKEN=
